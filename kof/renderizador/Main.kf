// ==========================================================================
// mytarot.day — porte nativo do gen-html.js para Kof.
//
// Pre-renderiza o HTML de cada um dos 28 idiomas a partir de
// content/views/index.html, usando engine/locales.json + <code>.ui.json
// (produzidos por config/Main.kf e reshape/Main.kf) e o campo `faq` bruto de
// content/data/<code>.json. Substitui gen-html.js, que fazia require() de
// content/lib/i18n.js e content/lib/render.js.
//
// O bloco JSON-LD e' escrito a mao (nao via json.encode) porque a forma e'
// fixa (sempre WebApplication + Organization, FAQPage so quando o idioma tem
// `faq`) mas precisa bater byte a byte com o `JSON.stringify(dados, null, 4)`
// original — e o json.encode do Kof so emite compacto, sem indentacao.
// Testado contra a saida real do gen-html.js: escrever a mao com a
// indentacao literal certa e' mais simples e mais confiavel do que escrever
// um reformatador generico de JSON compacto -> indentado.
//
//   kof run Main.kf
// ==========================================================================

record IdiomaCfg(String code, String nativeName, Int isRtl, String questionMark, String dateFormat)
record Alias(String from, String to)
record Locales(List<String> supported, String fallback, List<Alias> aliases, List<IdiomaCfg> idiomas)
record Faq(String q, String a)

String templatePath() { return "/home/publio/mytarot/views/index.html" }
String dataDir() { return "/home/publio/mytarot/data" }
String outDir() { return "/home/publio/Downloads/install/mytarot-kof/server" }
String baseUrl() { return "https://mytarot.day" }

String ler(String caminho) {
    var raw = File(caminho).readText()
    if (raw != null) {
        return raw
    }
    return ""
}

String replaceAll(String src, String needle, String rep) {
    var out = ""
    var rest = src
    var guard = 0
    while (guard < 200) {
        var at = rest.indexOf(needle)
        if (at < 0) {
            guard = 200
        } else {
            out = out + rest.substring(0, at) + rep
            rest = rest.substring(at + needle.length)
            guard = guard + 1
        }
    }
    return out + rest
}

String escapeHtml(String s) {
    var out = replaceAll(s, "&", "&amp;")
    out = replaceAll(out, "<", "&lt;")
    out = replaceAll(out, ">", "&gt;")
    out = replaceAll(out, "\"", "&quot;")
    out = replaceAll(out, "'", "&#39;")
    return out
}

String jsonStr(String s) {
    return "\"" + strings.escapeJson(s) + "\""
}

String pad2(Long v) {
    if (v < 10) {
        return "0" + v
    }
    return "" + v
}

// epoch millis -> "YYYY-MM-DD" (so a data, pelo algoritmo civil_from_days —
// mesma logica de server/Main.kf.isoFromMillis, truncada).
String dataFromMillis(Long ms) {
    var days = ms / 86400000
    var z = days + 719468
    var era = z / 146097
    var doe = z - era * 146097
    var yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    var y = yoe + era * 400
    var doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    var mp = (5 * doy + 2) / 153
    var d = doy - (153 * mp + 2) / 5 + 1
    var m = mp + 3
    if (mp >= 10) {
        m = mp - 9
    }
    if (m <= 2) {
        y = y + 1
    }
    return y + "-" + pad2(m) + "-" + pad2(d)
}

String extraiValorBalanceado(String s, Int inicio) {
    var i = inicio
    while (i < s.length && s.charAt(i) != '{' && s.charAt(i) != '[') {
        i = i + 1
    }
    var abre = s.charAt(i)
    var fecha = '}'
    if (abre == '[') {
        fecha = ']'
    }
    var profundidade = 0
    var dentroDeString = 0
    var j = i
    while (j < s.length) {
        var c = s.charAt(j)
        if (dentroDeString == 1) {
            if (c == '\\') {
                j = j + 1
            } else if (c == '"') {
                dentroDeString = 0
            }
        } else {
            if (c == '"') {
                dentroDeString = 1
            } else if (c == abre) {
                profundidade = profundidade + 1
            } else if (c == fecha) {
                profundidade = profundidade - 1
                if (profundidade == 0) {
                    return s.substring(i, j + 1)
                }
            }
        }
        j = j + 1
    }
    return ""
}

String campoBruto(String json, String chave) {
    var agulha = "\"" + chave + "\""
    var at = json.indexOf(agulha)
    if (at < 0) {
        return ""
    }
    var resto = json.substring(at + agulha.length)
    var doisPontos = resto.indexOf(":")
    if (doisPontos < 0) {
        return ""
    }
    return extraiValorBalanceado(json, at + agulha.length + doisPontos + 1)
}

String homeHref(String code) {
    if (code == "en") {
        return "/"
    }
    return "/" + code + "/"
}

String hreflangLinks(List<String> codes) {
    var out = ""
    var i = 0
    while (i < codes.size) {
        var code = codes.get(i)
        out = out + "<link rel=\"alternate\" hreflang=\"" + code + "\" href=\"" + baseUrl() + homeHref(code) + "\" />\n"
        i = i + 1
    }
    return out + "<link rel=\"alternate\" hreflang=\"x-default\" href=\"" + baseUrl() + "/\" />"
}

String languageSwitcher(List<IdiomaCfg> idiomas, String currentCode) {
    var out = ""
    var i = 0
    while (i < idiomas.size) {
        var cfg = idiomas.get(i)
        var code = cfg.code()
        var selected = ""
        if (code == currentCode) {
            selected = " selected"
        }
        var title = escapeHtml(cfg.nativeName())
        var href = homeHref(code)
        if (code == "en") {
            href = "/?lang=en"
        }
        out = out + "<option value=\"" + href + "\" title=\"" + title + "\"" + selected + ">" + code.toUpperCase() + "</option>"
        if (i < idiomas.size - 1) {
            out = out + "\n"
        }
        i = i + 1
    }
    return out
}

// Mesma forma fixa que render.js monta: WebApplication + Organization,
// FAQPage anexado so quando `faqs` nao esta vazio.
String jsonLd(String code, String canonicalUrl, String logo, String tagline, String dateModified, List<Faq> faqs) {
    var head = "{\n"
        + "    \"@context\": \"https://schema.org\",\n"
        + "    \"@graph\": [\n"
        + "        {\n"
        + "            \"@type\": \"WebApplication\",\n"
        + "            \"name\": " + jsonStr(logo) + ",\n"
        + "            \"url\": " + jsonStr(canonicalUrl) + ",\n"
        + "            \"description\": " + jsonStr(tagline) + ",\n"
        + "            \"applicationCategory\": \"LifestyleApplication\",\n"
        + "            \"operatingSystem\": \"Any\",\n"
        + "            \"inLanguage\": " + jsonStr(code) + ",\n"
        + "            \"isAccessibleForFree\": true,\n"
        + "            \"datePublished\": \"2026-08-09\",\n"
        + "            \"dateModified\": " + jsonStr(dateModified) + ",\n"
        + "            \"featureList\": [\n"
        + "                \"Shuffle and pick your own four cards from an open fan\",\n"
        + "                \"Determinant, Past, Present, and Future four-card spread\",\n"
        + "                \"Genuinely random draw every time, no birth date or personal number needed\",\n"
        + "                \"28 languages\",\n"
        + "                \"No signup, no account, free forever\"\n"
        + "            ],\n"
        + "            \"isPartOf\": {\n"
        + "                \"@type\": \"WebSite\",\n"
        + "                \"name\": \"MyTarot.Day\",\n"
        + "                \"url\": \"" + baseUrl() + "/\"\n"
        + "            }\n"
        + "        },\n"
        + "        {\n"
        + "            \"@type\": \"Organization\",\n"
        + "            \"name\": \"P.San Team\",\n"
        + "            \"url\": \"" + baseUrl() + "/\",\n"
        + "            \"sameAs\": [\n"
        + "                \"https://myzodiac.day\"\n"
        + "            ]\n"
        + "        }"

    if (faqs.size == 0) {
        return head + "\n    ]\n}"
    }

    var itens = ""
    var i = 0
    while (i < faqs.size) {
        var f = faqs.get(i)
        itens = itens
            + "                {\n"
            + "                    \"@type\": \"Question\",\n"
            + "                    \"name\": " + jsonStr(f.q()) + ",\n"
            + "                    \"acceptedAnswer\": {\n"
            + "                        \"@type\": \"Answer\",\n"
            + "                        \"text\": " + jsonStr(f.a()) + "\n"
            + "                    }\n"
            + "                }"
        if (i < faqs.size - 1) {
            itens = itens + ",\n"
        }
        i = i + 1
    }

    var faqBlock = ",\n"
        + "        {\n"
        + "            \"@type\": \"FAQPage\",\n"
        + "            \"mainEntity\": [\n"
        + itens + "\n"
        + "            ]\n"
        + "        }"

    return head + faqBlock + "\n    ]\n}"
}

List<String> chavesUi() {
    return listOf("logo", "tagline", "eyebrow", "selectCardsPrompt", "heroTitleLine1",
        "heroTitleEm", "submitLabel", "submittingLabel", "loadingText", "tryAnotherLabel",
        "buyMeCoffeeLabel", "funFact", "footerDisclaimer", "footerTagline", "footerHome",
        "footerBlog", "footerPrivacy", "footerTerms", "footerAbout", "footerContact",
        "todayBadge", "reversedLabel", "uprightLabel", "supportPromptText",
        "summaryGuideLabel", "summaryPastLabel", "summaryFutureLabel", "freeBadge",
        "freeTitlePhrase", "skipToContent")
}

main() {
    var template = ler(templatePath())
    var tabela = json.decode<Locales>(ler("/home/publio/Downloads/install/mytarot-kof/engine/locales.json"))
    var idiomas = tabela.idiomas()
    var chaves = chavesUi()

    var assetVersion = now()
    var dateModified = dataFromMillis(assetVersion)
    var hreflang = hreflangLinks(tabela.supported())

    var escritos = 0
    var i = 0
    while (i < idiomas.size) {
        var cfg = idiomas.get(i)
        var code = cfg.code()

        var ui = json.decode<Map<String, String>>(ler("/home/publio/Downloads/install/mytarot-kof/engine/" + code + ".ui.json"))

        var raw = ler(dataDir() + "/" + code + ".json")
        var faqJson = campoBruto(raw, "faq")
        var faqs = listOf()
        if (faqJson.length > 0) {
            faqs = json.decode<List<Faq>>(faqJson)
        }

        var canonicalUrl = baseUrl() + homeHref(code)
        var logo = ui.get("logo")
        var tagline = ui.get("tagline")
        var freeTitlePhrase = ui.get("freeTitlePhrase")

        var skipLinkText = ui.get("skipToContent")
        if (skipLinkText == null) {
            skipLinkText = "Skip to main content"
        }

        // Montado a mao (nao via json.encode de Map) para preservar a ORDEM
        // exata de CLIENT_UI_KEYS do render.js — um Map no Kof nao garante
        // ordem de insercao no encode (testado: sai em ordem alfabetica).
        var pares = ""
        var vSubmit = ui.get("submitLabel")
        if (vSubmit != null) {
            pares = pares + jsonStr("submitLabel") + ":" + jsonStr(vSubmit)
        }
        var vReversed = ui.get("reversedLabel")
        if (vReversed != null) {
            if (pares.length > 0) { pares = pares + "," }
            pares = pares + jsonStr("reversedLabel") + ":" + jsonStr(vReversed)
        }
        var vUpright = ui.get("uprightLabel")
        if (vUpright != null) {
            if (pares.length > 0) { pares = pares + "," }
            pares = pares + jsonStr("uprightLabel") + ":" + jsonStr(vUpright)
        }
        var vToday = ui.get("todayBadge")
        if (vToday != null) {
            if (pares.length > 0) { pares = pares + "," }
            pares = pares + jsonStr("todayBadge") + ":" + jsonStr(vToday)
        }
        var clientI18nJson = replaceAll("{" + pares + "}", "<", "\\u003c")

        var ld = "<script type=\"application/ld+json\">\n"
            + replaceAll(jsonLd(code, canonicalUrl, logo, tagline, dateModified, faqs), "<", "\\u003c")
            + "\n</script>"

        var localeDir = "ltr"
        if (cfg.isRtl() == 1) {
            localeDir = "rtl"
        }

        var html = template
        html = replaceAll(html, "{{LOCALE_CODE}}", code)
        html = replaceAll(html, "{{LOCALE_DIR}}", localeDir)
        html = replaceAll(html, "{{QUESTION_MARK}}", cfg.questionMark())
        html = replaceAll(html, "{{CANONICAL_URL}}", canonicalUrl)
        html = replaceAll(html, "{{ASSET_VERSION}}", "" + assetVersion)
        html = replaceAll(html, "{{DATE_PUBLISHED}}", "2026-08-09")
        html = replaceAll(html, "{{DATE_MODIFIED}}", dateModified)
        html = replaceAll(html, "{{SKIP_LINK_TEXT}}", escapeHtml(skipLinkText))
        html = replaceAll(html, "{{OG_IMAGE_URL}}", baseUrl() + "/og-image.png")
        html = replaceAll(html, "{{HREFLANG_LINKS}}", hreflang)
        html = replaceAll(html, "{{JSON_LD}}", ld)
        html = replaceAll(html, "{{LANGUAGE_SWITCHER}}", languageSwitcher(idiomas, code))
        html = replaceAll(html, "{{HOME_HREF}}", homeHref(code))
        html = replaceAll(html, "{{CLIENT_I18N_JSON}}", clientI18nJson)
        html = replaceAll(html, "{{PAGE_TITLE}}", escapeHtml(freeTitlePhrase + " — " + logo))
        html = replaceAll(html, "{{META_DESCRIPTION}}", escapeHtml(tagline))

        var k = 0
        while (k < chaves.size) {
            var chave = chaves.get(k)
            var valor = ui.get(chave)
            if (valor == null) {
                valor = ""
            }
            html = replaceAll(html, "{{ui." + chave + "}}", escapeHtml(valor))
            k = k + 1
        }

        var ok = File(outDir() + "/" + code + ".html").writeText(html)
        if (ok) {
            escritos = escritos + 1
        }
        i = i + 1
    }
    println("html gerados: " + escritos + " de " + idiomas.size)
}
